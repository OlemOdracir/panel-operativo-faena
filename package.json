{
  "name": "panel-operativo-faena",
  "version": "0.1.0",
  "private": true,
  "description": "Panel operativo para monitoreo de sensores y gestión de trabajo en una faena minera.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"corepack pnpm --filter @faena/api start:dev\" \"corepack pnpm --filter @faena/web dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm --recursive --if-present run lint",
    "typecheck": "corepack pnpm --recursive --if-present run typecheck",
    "test": "corepack pnpm --filter @faena/contracts build && corepack pnpm --recursive --if-present run test:ci",
    "test:e2e:audit": "playwright test --config playwright.config.ts",
    "prepare": "husky",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs --follow",
    "docs:check": "node scripts/check-openapi.mjs",
    "encoding:check": "node scripts/check-encoding.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.58.2",
    "concurrently": "10.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,md,mjs,ts,tsx,yaml,yml}": "prettier --write"
  }
}
