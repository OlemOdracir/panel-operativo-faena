# Runtime
NODE_ENV=development
API_PORT=3000
WEB_PORT=8080
LOG_LEVEL=debug

# Browser access
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
SWAGGER_ENABLED=true

# PostgreSQL (development values only; replace them outside local development)
POSTGRES_DB=faena
POSTGRES_USER=faena_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://faena_app:replace_with_a_local_password@localhost:5432/faena?schema=public

# Authentication
JWT_SECRET=replace_with_at_least_32_random_characters
AUTH_COOKIE_SECURE=false
SEED_ADMIN_PASSWORD=replace_with_a_12_character_local_password
SEED_SUPERVISOR_PASSWORD=replace_with_a_12_character_local_password
